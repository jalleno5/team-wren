# Set these in your shell or hosting provider. Files are not automatically loaded.
MUSIC_API_KEY=generate a secret for each user.
MUSICGEN_MODEL=facebook/musicgen-small
#default to small musicgen for fastest runtime


# MUSIC_OUTPUT_DIR=/data/music/outputs
# MUSIC_SOUNDS_DIR=/data/music/sounds
# HF_HOME=/data/models/huggingface
# MT3_CHECKPOINT_DIR=/data/models/mt3
# HDemucs downloads once through TorchAudio; this keeps its weights in the local cache:
# TORCH_HOME=outputs/.model_cache/torch

# Vercel server environment only (never VITE_ variables):
MUSIC_WORKER_URL=https://your-worker.example.com

#This can be combined with the other env in the future. 