# Supabase is used for Google authentication only in the browser. All row data
# goes through the application API; never place a service-role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Leave blank for same-origin /api requests (and the Vite port-3001 proxy).
# Set this only when the deployed API lives on a separate origin.
VITE_API_BASE_URL=
